# =====================================================================
# AkarAI Studio - Wan 2.2 Animate untuk Vast.ai Serverless
#
# Strategi: SEMUA masuk image (ComfyUI + custom nodes + model ~32GB)
#   - Worker TIDAK perlu download model saat start
#   - Cukup pull image lalu langsung siap render
#
# Base : vastai/comfy (sudah berisi ComfyUI + pyworker)
# Build: via GitHub Actions (runner punya disk & bandwidth besar)
# =====================================================================

FROM vastai/comfy:v0.34.0-cuda-13.2-py312

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0

WORKDIR /workspace

# ---------------------------------------------------------------
# 1. ComfyUI path (image vastai memakai /workspace/ComfyUI)
# ---------------------------------------------------------------
ENV COMFY_DIR=/workspace/ComfyUI
ENV MODEL_DIR=/workspace/ComfyUI/models

# ---------------------------------------------------------------
# 2. Custom nodes yang dibutuhkan workflow
# ---------------------------------------------------------------
RUN cd /workspace/ComfyUI/custom_nodes && \
    git clone --depth 1 https://github.com/kijai/ComfyUI-WanVideoWrapper.git && \
    git clone --depth 1 https://github.com/kijai/ComfyUI-KJNodes.git && \
    git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    git clone --depth 1 https://github.com/Wan-Video/ComfyUI-WanVideoAnimate.git || true

# Dependencies custom nodes (best effort - jangan gagalkan build)
RUN cd /workspace && \
    for d in ComfyUI/custom_nodes/*/; do \
        if [ -f "$d/requirements.txt" ]; then \
            pip install --no-cache-dir -r "$d/requirements.txt" || true; \
        fi; \
    done

# ---------------------------------------------------------------
# 3. Model Wan 2.2 Animate (~32GB)
#    URL sudah diverifikasi (HTTP 200)
# ---------------------------------------------------------------
RUN mkdir -p /workspace/ComfyUI/models/{diffusion_models,text_encoders,vae,clip_vision,loras,dwpose} && \
    pip install --no-cache-dir huggingface_hub[cli]

# Model utama 17.5GB
RUN huggingface-cli download Kijai/WanVideo_comfy_fp8_scaled \
        Wan22Animate/Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv "/tmp/dl/Wan22Animate/Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors" \
       /workspace/ComfyUI/models/diffusion_models/ && rm -rf /tmp/dl

# Text encoder 10.8GB
RUN huggingface-cli download Kijai/WanVideo_comfy \
        umt5-xxl-enc-bf16.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv /tmp/dl/umt5-xxl-enc-bf16.safetensors \
       /workspace/ComfyUI/models/text_encoders/ && rm -rf /tmp/dl

# VAE 242MB
RUN huggingface-cli download Comfy-Org/Wan_2.1_ComfyUI_repackaged \
        split_files/vae/wan_2.1_vae.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv /tmp/dl/split_files/vae/wan_2.1_vae.safetensors \
       /workspace/ComfyUI/models/vae/ && rm -rf /tmp/dl

# CLIP Vision 1.2GB
RUN huggingface-cli download Comfy-Org/Wan_2.1_ComfyUI_repackaged \
        split_files/clip_vision/clip_vision_h.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv /tmp/dl/split_files/clip_vision/clip_vision_h.safetensors \
       /workspace/ComfyUI/models/clip_vision/ && rm -rf /tmp/dl

# LoRA lightx2v 703MB
RUN huggingface-cli download Kijai/WanVideo_comfy \
        Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv /tmp/dl/Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors \
       /workspace/ComfyUI/models/loras/ && rm -rf /tmp/dl

# LoRA relight 1.4GB
RUN huggingface-cli download Kijai/WanVideo_comfy \
        LoRAs/Wan22_relight/WanAnimate_relight_lora_fp16.safetensors \
        --local-dir /tmp/dl --local-dir-use-symlinks False && \
    mv /tmp/dl/LoRAs/Wan22_relight/WanAnimate_relight_lora_fp16.safetensors \
       /workspace/ComfyUI/models/loras/ && rm -rf /tmp/dl

# ---------------------------------------------------------------
# 4. Workflow API
# ---------------------------------------------------------------
COPY workflow_api.json /workspace/ComfyUI/workflow_api.json

# ---------------------------------------------------------------
# 5. Verifikasi isi image (muncul di log build)
# ---------------------------------------------------------------
RUN echo "=== ISI MODEL ===" && \
    du -sh /workspace/ComfyUI/models/* && \
    echo "=== CUSTOM NODES ===" && \
    ls /workspace/ComfyUI/custom_nodes/

EXPOSE 8188 18188
