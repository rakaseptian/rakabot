# =====================================================================
# AkarAI Studio - Wan 2.2 Animate untuk Vast.ai Serverless
#
# PENTING: base image vastai/comfy TIDAK berisi ComfyUI!
#   Ia hanya kerangka (pyworker bootstrap + supervisor).
#   Inference engine (ComfyUI) HARUS di-install oleh template ini.
#   Tanpa itu: "can't open file '/workspace/ComfyUI/main.py'"
#   -> benchmark gagal -> worker di-destroy berulang.
#
# Strategi: SEMUA masuk image (ComfyUI + custom nodes + model ~32GB)
# Build   : via GitHub Actions (runner punya disk & bandwidth besar)
# =====================================================================

FROM vastai/comfy:v0.34.0-cuda-13.2-py312

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

ENV COMFY_DIR=/workspace/ComfyUI
ENV MODEL_DIR=/workspace/ComfyUI/models

# ---------------------------------------------------------------
# 0. INSTALL COMFYUI (WAJIB — base image tidak menyertakannya)
# ---------------------------------------------------------------
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git /workspace/ComfyUI

# Dependencies ComfyUI
RUN cd /workspace/ComfyUI && \
    pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------
# 1. Custom nodes
# ---------------------------------------------------------------
RUN mkdir -p /workspace/ComfyUI/custom_nodes && cd /workspace/ComfyUI/custom_nodes && \
    git clone --depth 1 https://github.com/kijai/ComfyUI-WanVideoWrapper.git ; \
    git clone --depth 1 https://github.com/kijai/ComfyUI-KJNodes.git ; \
    git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git ; \
    git clone --depth 1 https://github.com/cubiq/ComfyUI_essentials.git ; \
    true

# Dependencies custom nodes (best effort)
RUN cd /workspace && \
    for d in ComfyUI/custom_nodes/*/; do \
        if [ -f "$d/requirements.txt" ]; then \
            pip install --no-cache-dir -r "$d/requirements.txt" || true; \
        fi; \
    done ; true

# ---------------------------------------------------------------
# 2. Model Wan 2.2 Animate (~32GB) via curl langsung
# ---------------------------------------------------------------
RUN mkdir -p /workspace/ComfyUI/models/diffusion_models /workspace/ComfyUI/models/text_encoders /workspace/ComfyUI/models/vae /workspace/ComfyUI/models/clip_vision /workspace/ComfyUI/models/loras

# Model utama 17.5GB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/diffusion_models/Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors \
      "https://huggingface.co/Kijai/WanVideo_comfy_fp8_scaled/resolve/main/Wan22Animate/Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors"

# Text encoder 10.8GB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/text_encoders/umt5-xxl-enc-bf16.safetensors \
      "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/umt5-xxl-enc-bf16.safetensors"

# VAE 242MB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/vae/wan_2.1_vae.safetensors \
      "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/vae/wan_2.1_vae.safetensors"

# CLIP Vision 1.2GB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/clip_vision/clip_vision_h.safetensors \
      "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/clip_vision/clip_vision_h.safetensors"

# LoRA lightx2v 703MB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/loras/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors \
      "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors"

# LoRA relight 1.4GB
RUN curl -L --retry 5 --retry-delay 5 -C - -o /workspace/ComfyUI/models/loras/WanAnimate_relight_lora_fp16.safetensors \
      "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/LoRAs/Wan22_relight/WanAnimate_relight_lora_fp16.safetensors"

# ---------------------------------------------------------------
# 3. Workflow API
# ---------------------------------------------------------------
COPY workflow_api.json /workspace/ComfyUI/workflow_api.json

# ---------------------------------------------------------------
# 4. Verifikasi isi image
#    PENTING: build GAGAL kalau main.py tidak ada,
#    supaya tidak terulang error "can't open file main.py"
# ---------------------------------------------------------------
RUN test -f /workspace/ComfyUI/main.py || \
    (echo "FATAL: ComfyUI main.py tidak ditemukan!" && exit 1)

RUN echo "=== COMFYUI ===" && \
    ls -la /workspace/ComfyUI/main.py && \
    echo "=== ISI MODEL ===" && \
    ls -lh /workspace/ComfyUI/models/diffusion_models/ \
           /workspace/ComfyUI/models/text_encoders/ \
           /workspace/ComfyUI/models/vae/ \
           /workspace/ComfyUI/models/clip_vision/ \
           /workspace/ComfyUI/models/loras/ && \
    echo "=== CUSTOM NODES ===" && \
    ls -la /workspace/ComfyUI/custom_nodes/ 2>/dev/null || echo "no nodes"

EXPOSE 8188 18188 3000
